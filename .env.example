# ─── Required ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── Bridge APIs ─────────────────────────────────────────────────────────────
WORMHOLE_API_KEY=               # optional — wormholescan.io

# ─── Alert Thresholds ────────────────────────────────────────────────────────
LARGE_TRANSFER_THRESHOLD_USD=500000   # flag transfers above $500K
VOLUME_SPIKE_MULTIPLIER=5             # flag bridge volume 5x above baseline
ALERT_MIN_CONFIDENCE=0.65

# ─── Coverage ────────────────────────────────────────────────────────────────
TRACKED_BRIDGES=wormhole,allbridge
TRACKED_CHAINS=solana,ethereum,base,arbitrum

# ─── Scanner ─────────────────────────────────────────────────────────────────
SCAN_INTERVAL_MS=120000         # every 2 minutes

# ─── Model ───────────────────────────────────────────────────────────────────
CLAUDE_MODEL=claude-sonnet-4-6
